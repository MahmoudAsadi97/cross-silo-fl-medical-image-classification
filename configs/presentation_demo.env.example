# Copy to configs/presentation_demo.env, or run:
#   bash scripts/live/presentation_demo.sh --configure
# The real .env file is ignored by Git.

PI_SSH_TARGET=<pi-user>@raspberrypi.local
PI_REPO=/home/<pi-user>/cross-silo-fl-medical-image-classification
PI_DATA_ROOT=/home/<pi-user>/fl_data/fed_isic2019/raw
LAPTOP_DATA_ROOT=/home/<user>/fl_data/fed_isic2019/raw
PI_IDENTITY_FILE=/home/<user>/.ssh/fl_demo_pi_ed25519

CONDA_ENV=flamby_isic
ROUNDS=3
MAX_BATCHES=4
ROUND_TIMEOUT=120
DEMO_TIMEOUT=240
PI_BOOT_WAIT=30

# The presentation launcher deliberately pins the legacy Flower API used by
# scripts/live/server.py and client.py on both physical devices.
EXPECTED_FLOWER=1.11.1
